# ---- Django ----
DJANGO_DEBUG=True
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-production
# Comma separated. In production put your Render/Koyeb hostname.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Needed for /admin on HTTPS hosts, e.g. https://sms-sentinel-api.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---- Database ----
# Leave EMPTY to use a local SQLite file (zero setup on your PC).
# Postgres (local docker):  postgres://sentinel:sentinel@localhost:5432/sentinel
# Neon / Supabase:          postgresql://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL=

# ---- API protection (optional but recommended) ----
# If set, the app must send header "X-API-Key: <value>". Put the same value in
# apps/mobile/.env as EXPO_PUBLIC_API_KEY. NOTE: it ships inside the APK, so it only
# deters casual abuse - it is not a real secret.
APP_API_KEY=
# DRF throttle for each client IP
THROTTLE_RATE=60/min

# ---- AI provider ----
# none | gemini | groq | openai | openrouter | huggingface | custom
AI_PROVIDER=none
AI_API_KEY=
# Optional overrides. Defaults per provider are in analysis/services/ai_client.py
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=8

# ---- Privacy ----
# False (default): only a SHA-256 hash of each SMS is stored. True: also store the first 160 chars.
STORE_MESSAGE_BODY=False
