# Copy to .env  (apps/mobile/.env). Only EXPO_PUBLIC_* variables are readable by the app,
# and they are baked into the bundle at build time. Never put real secrets here.

# URL of your Django backend (no trailing slash).
#   Android emulator -> PC:   http://10.0.2.2:8000
#   Real phone, same Wi-Fi:   http://192.168.X.X:8000   (your PC's LAN IP)
#   Public / friends:         https://your-app.onrender.com  or a cloudflared/ngrok tunnel
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Must equal APP_API_KEY in apps/backend/.env (leave empty if the backend has none).
EXPO_PUBLIC_API_KEY=
